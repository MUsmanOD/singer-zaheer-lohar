# MongoDB Atlas or another MongoDB replica-set connection string.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/zaheer-lohar?retryWrites=true&w=majority

# Seed the first admin account with: npm run seed
# The seed upserts this email and password into MongoDB as a scrypt hash.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# YouTube Data API v3 key. Never prefix this with NEXT_PUBLIC_.
YOUTUBE_API_KEY=

# Public origin used for canonical URLs and social metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional separate secret used to hash rate-limit client identifiers.
RATE_LIMIT_SALT=

# Optional secret used to hash short-lived duplicate booking fingerprints.
BOOKING_DEDUPE_SECRET=
